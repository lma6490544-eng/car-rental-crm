{
  "name": "@crm/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsc && concurrently -k -n types,server \"tsc --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:integration": "node --test tests/stage1.integration.cjs",
    "admin:create": "node dist/bootstrap-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "nodemailer": "10.6.1",
    "pg": "^8.16.3",
    "playwright": "^1.65.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5"
  }
}

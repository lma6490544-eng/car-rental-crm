# Local development only. Copy to .env before starting.
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_local_dev
POSTGRES_DB=car_rental_crm
POSTGRES_PORT=15432
DATABASE_URL=postgresql://crm:crm_local_dev@127.0.0.1:15432/car_rental_crm
API_PORT=3001

# Web Push: generate a stable key pair with the installed web-push CLI.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=

# Browser origins allowed for state-changing API requests.
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Accounting email is sent when the API has a Yandex Mail app password.
ACCOUNTING_SMTP_USER=mihaillgt@yandex.com
ACCOUNTING_EMAIL_TO=soforadc@gmail.com
ACCOUNTING_SMTP_APP_PASSWORD=
# Initial admin: npm run admin:create; generated credentials go to .local/initial-admin.txt.
# Optional ADMIN_LOGIN, ADMIN_FULL_NAME, ADMIN_PASSWORD via process environment.
